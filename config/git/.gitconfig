[user]
	name = Jorge Thomas (Akrista)
	email = 23145794+Akrista@users.noreply.github.com

[core]
	autocrlf = input
	editor = nvim

[init]
	defaultBranch = master

[pull]
	rebase = false

[alias]
	st = status
	co = checkout
	br = branch
	cm = commit

[push]
	autoSetupRemote = true

[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

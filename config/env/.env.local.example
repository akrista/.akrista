# ==============================================================================
#  🔒 Local / Machine-Specific Environment Variables (.env.local)
# ==============================================================================
#  This file is automatically sourced by both Bash (~/.bashrc) and Zsh (~/.zshenv).
#  It is untracked by Git, making it the ideal place for machine-specific paths,
#  hardware configurations, private API keys, and local environment overrides.
# ==============================================================================

# --- Java Development Kit (JDK) ---
# Example: JetBrains Runtime (JBR) from Android Studio
# export JAVA_HOME="$HOME/.local/share/JetBrains/Toolbox/apps/android-studio/jbr"
# [ -d "$JAVA_HOME/bin" ] && export PATH="$JAVA_HOME/bin:$PATH"

# Example: System OpenJDK
# export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"
# [ -d "$JAVA_HOME/bin" ] && export PATH="$JAVA_HOME/bin:$PATH"

# --- Android SDK & Platform Tools ---
# export ANDROID_HOME="$HOME/Android/Sdk"
# [ -d "$ANDROID_HOME/platform-tools" ] && export PATH="$ANDROID_HOME/platform-tools:$PATH"
# [ -d "$ANDROID_HOME/cmdline-tools/latest/bin" ] && export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"

# --- Custom / Work-Specific Paths ---
# export WORK_PROJECTS="$HOME/Work/Projects"
# export PATH="$HOME/.custom-bin:$PATH"

# --- Private API Keys & Credentials (Untracked) ---
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."
# export CONTEXT7_API_KEY="ctx7sk-..."
# export WAKATIME_API_KEY="..."

# --- Machine-Specific Proxy / Corporate Network ---
# export HTTP_PROXY="http://127.0.0.1:8080"
# export HTTPS_PROXY="http://127.0.0.1:8080"

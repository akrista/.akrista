{
  "mcpServers": {
    "context7": {
      "command": "bunx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ],
      "env": {
        "CONTEXT7_API_KEY": "<YOUR_CONTEXT7_API_KEY>"
      }
    },
    "dbhub": {
      "command": "dbhub",
      "args": [
        "--transport",
        "stdio",
        "--dsn",
        "${DATABASE_URL}"
      ]
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "nextjs": {
      "command": "bunx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    }
  }
}
